{
  "name": "ipfs_module",
  "display_name": "IPFS Node",
  "version": "0.1.1",
  "description": "An IPFS node for every Logos app on this device: runs a bundled Kubo on loopback ports and exposes its RPC API and gateway. Apps pin, fetch and provide content-addressed data without a third-party gateway.",
  "author": "vpavlin",
  "type": "core",
  "interface": "cdylib",
  "concurrency": "multi",
  "category": "protocol",
  "main": "ipfs_module_plugin",
  "dependencies": [],
  "include": [],
  "platforms": [
    { "when": { "os": "linux" }, "include": ["ipfs"] },
    { "when": { "os": "darwin" }, "include": ["ipfs"] }
  ],
  "capabilities": [],
  "codegen": {
    "rust": { "crate": "rust-lib", "trait": "IpfsModule", "source": "src/glue.rs" }
  },
  "nix": {
    "external_libraries": [],
    "packages": { "build": [], "runtime": [] },
    "platforms": [
      { "when": { "os": "linux" }, "packages": { "runtime": ["pkgsStatic.kubo"] } },
      { "when": { "os": "darwin" }, "packages": { "runtime": ["kubo"] } }
    ],
    "cmake": { "find_packages": [], "extra_include_dirs": [] }
  }
}
